# Copy this file to .env.local for local development. Never commit .env.local.
# Use the production Vercel URL here after deployment (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase browser configuration. These are public values and may be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older Supabase projects can use this instead of the publishable key above.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public campaign film URL. Paste any normal YouTube watch or share URL.
NEXT_PUBLIC_CAMPAIGN_YOUTUBE_URL=

# Server-only values. Set these in Vercel, never in client-side code or Git.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
